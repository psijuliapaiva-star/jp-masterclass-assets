-weight:400;font-style:normal;font-display:swap}\n@font-face{font-family:'Nimbus Sans Cond';src:url(\"https://raw.githubusercontent.com/psijuliapaiva-star/jp-masterclass-assets/main/assets/f7-nimbuscond-bold.otf\") format('opentype');font-weight:700;font-style:normal;font-display:swap}\n\n:root{\n--jp-green:#D3FB04;\n--jp-green-hover:#E2FF4D;\n--jp-green-olive:#A8C803;\n--jp-green-olive-dark:#7F9C02;\n--jp-green-pill-text:#4B5C02;\n--jp-green-pill-bg:rgba(211,251,4,.28);\n--jp-green-pill-bg-dark:rgba(211,251,4,.18);\n--jp-green-pill-border-dark:rgba(211,251,4,.7);\n--jp-green-shadow:rgba(168,200,3,.35);\n--jp-black:#191919;\n--jp-black-elevated:#262626;\n--jp-black-hover:#333333;\n--jp-bone:#F6F6F6;\n--jp-white:#FFFFFF;\n--jp-border-light:rgba(25,25,25,.08);\n--jp-border-medium:rgba(25,25,25,.14);\n--jp-border-outline:rgba(25,25,25,.25);\n--jp-divider-dark:rgba(246,246,246,.16);\n--text-body-light:rgba(25,25,25,.72);\n--text-secondary-light:rgba(25,25,25,.62);\n--text-muted-light:rgba(25,25,25,.55);\n--text-faint-light:rgba(25,25,25,.5);\n--text-body-dark:rgba(246,246,246,.7);\n--text-secondary-dark:rgba(246,246,246,.75);\n--text-muted-dark:rgba(246,246,246,.6);\n--text-faint-dark:rgba(246,246,246,.5);\n--surface-page:var(--jp-bone);\n--surface-card:var(--jp-white);\n--surface-card-border:var(--jp-border-light);\n--surface-contrast:var(--jp-black);\n--surface-contrast-border:var(--jp-green);\n--surface-contrast-elevated:var(--jp-black-elevated);\n--accent:var(--jp-green);\n--accent-text-on-light:var(--jp-green-olive);\n--accent-on-dark:var(--jp-green);\n--fg-primary:var(--jp-black);\n--fg-on-contrast:var(--jp-bone);\n}\n\n:root{\n--font-display:'Bethany Elingston',Georgia,serif;\n--font-label:'Nimbus Sans Cond',Helvetica,Arial,sans-serif;\n--font-body:'Nimbus Sans',Helvetica,Arial,sans-serif;\n--text-h1-size:76px;--text-h1-leading:1.02;--text-h1-tracking:-0.015em;\n--text-h2-size:52px;--text-h2-leading:1.1;\n--text-h3-size:24px;--text-h3-leading:1.25;\n--text-figure