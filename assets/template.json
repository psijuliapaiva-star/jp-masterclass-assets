x;--text-body-leading:1.6;--text-body-maxwidth:640px;\n--text-micro-size:13px;\n}\nbody,button,input,textarea,select{font-variant-ligatures:none;font-feature-settings:\"liga\" 0,\"dlig\" 0}\n\n:root{\n--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:20px;--space-6:24px;--space-8:32px;--space-10:40px;--space-12:48px;--space-16:64px;--space-20:80px;\n--radius-pill:999px;--radius-card:18px;--radius-card-sm:14px;--radius-card-inner:12px;\n--content-maxwidth:1200px;--content-padding-desktop:72px;\n--section-padding-y:76px;\n--shadow-card:0 2px 14px rgba(25,25,25,.05);\n--shadow-button:0 6px 18px rgba(168,200,3,.35);\n}\n\n</style>\n\n<style>\nbody{margin:0;background:#F6F6F6;font-family:'Nimbus Sans',Helvetica,Arial,sans-serif;color:#191919;font-variant-ligatures:none}\na{color:#A8C803;text-decoration:none}\na:hover{color:#7F9C02}\n</style>\n<style>\nx-dc,helmet{display:block}\n.jp-pill{display:inline-flex;align-items:center;font-family:var(--font-label);font-size:var(--text-pill-size);letter-spacing:var(--text-pill-tracking);text-transform:uppercase;font-weight:700;padding:7px 18px;border-radius:var(--radius-pill);background:var(--jp-green-pill-bg);color:var(--jp-green-pill-text)}\n.jp-pill--dark{background:var(--jp-green-pill-bg-dark);color:var(--jp-green);border:1px solid var(--jp-green-pill-border-dark)}\n.jp-card{background:var(--surface-card);border:1px solid var(--surface-card-border);border-radius:var(--radius-card);box-shadow:var(--shadow-card);padding:28px}\n.jp-card--pad48{padding:48px}\n.jp-card--pad40{padding:40px}\n.jp-button{display:inline-flex;align-items:center;justify-content:center;font-family:var(--font-label);font-size:var(--text-button-size);letter-spacing:var(--text-button-tracking);text-transform:uppercase;font-weight:700;height:56px;padding:0 34px;border:none;border-radius:var(--radius-pill);background:var(--jp-green);color:var(--jp-black);box-shadow:var(--shadow-button);cursor:pointer;transition:background .2s ease}\n.jp-button:hover{background:var(--jp-green-hover)}\n.jp-section-header{text-align:center;margin-bottom:8px}\n.jp-section-header h2{font-family:var(--font-display);font-weight:400;font-size:clamp(34px,4.4vw,52px);line-height:1.1;margin:20px 0 16px}\n.jp-section-header p{font-size:17px;line-height:1.7;max-width:640px;margin:0 auto;color:rgba(25,25,25,.72)}\n.jp-section-header--dark h2{color:#F6F6F6}\n.jp-section-header--dark p{color:rgba(246,246,246,.75)}\n.jp-price-card{background:var(--surface-contrast);color:var(--jp-bone);border-radius:var(--radius-card);padding:40px;text-align:center;border:2px solid var(--jp-green)}\n.jp-price-card .eyebrow{font-family:var(--font-label);font-size:13px;letter-spacing:.18em;text-transform:uppercase;color:rgba(246,246,246,.6)}\n.jp-price-card .price{font-family:var(--font-display);font-size:56px;color:var(--jp-green);margin:14px 0 4px}\n.jp-price-card .subline{font-size:15px;color:rgba(246,246,246,.7);margin-bottom:24px}\n.jp-price-card .microcopy{font-size:13px;color:rgba(246,246,246,.5);margin-top:16px}\n.jp-checklist{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px}\n.jp-checklist li{display:flex;gap:12px;align-items:flex-start;font-size:16px;line-height:1.5;color:rgba(25,25,25,.8)}\n.jp-checklist svg{flex-shrink:0;margin-top:2px}\n.jp-faq-item{border:1px solid var(--jp-border-light);border-radius:var(--radius-card-sm);padding:20px 24px}\n.jp-faq-item .idx{font-family:var(--font-label);font-size:13px;letter-spacing:.18em;color:var(--jp-green-olive);display:block;margin-bottom:6px}\n.jp-faq-item .title{font-family:var(--font-display);font-size:20px;margin:0 0 8px}\n.jp-faq-item .desc{font-size:15px;line-height:1.6;color:rgba(25,25,25,.65);margin:0}\n</style>\n\n\n\n\n<div style=\"background:#F6F6F6; width:100%; overflow-x:hidden\">\n\n  <section data-screen-label=\"Hero\" style=\"background-color:#191919; background-image:linear-gradient(to right, rgba(25,25,25,.94) 0%, rgba(25,25,25,.8) 42%, rgba(25,25,25,.35) 100%), url(&quot;https://raw.githubusercontent.com/psijuliapaiva-star/jp-masterclass-assets/main/assets/img-hero-bg.jpg&quot;); background-size:cover; background-position:center bottom; color:#F6F6F6; padding:clamp(32px,6vw,64px) clamp(20px,5vw,72px) clamp(40px,6vw,72px)\">\n    <div style=\"max-width:1200px; margin:0 auto\">\n      <div style=\"font-family:'Bethany Elingston',Georgia,serif; font-size:26px; color:#F6F6F6; margin-bottom:52px\">J\u00falia Paiva | Psi High Level</div>\n      <div style=\"display:grid; grid-template-columns:repeat(auto-fit,minmax(340px,1fr)); gap:64px; align-items:center\">\n        <div>\n          <span class=\"jp-pill jp-pill--dark\">Masterclass ao vivo \u00b7 14 de setembro</span>\n          <h1 style=\"font-family:'Bethany Elingston',Georgia,serif; font-weight:400; font-size:clamp(38px,4.2vw,64px); line-height:1.06; letter-spacing:-0.015em; margin:24px 0 22px; text-wrap:balance\">\n            Psi, faltam <span style=\"color:#D3FB04\">menos de 4 meses</span> pra 2026 acabar. Seu consult\u00f3rio vai fechar o ano do jeito que voc\u00ea prometeu em janeiro ou do mesmo jeito de sempre?\n          </h1>\n          <p style=\"font-size:18px; line-height:1.6; color:rgba(246,246,246,.75); max-width:620px; margin:0 0 30px; text-wrap:pretty\">\n            Nessa aula voc\u00ea aprende os 3 pilares que mudam o seu resultado, de forma mais r\u00e1pida nos \u00faltimos meses do ano, sustentado por posicionamento claro e um plano at\u00e9 dezembro, com pacientes novos e sem sufoco.\n          </p>\n          <div style=\"display:flex; flex-direction:column; gap:12px; margin-bottom:34px; max-width:560px\">\n            <div style=\"display:flex; gap:14px; align-items:baseline; border-top:1px solid rgba(246,246,246,.16); padding-top:12px\">\n              <span style=\"font-family:'Nimbus Sans Cond',Helvetica,Arial,sans-serif; font-size:13px; letter-spacing:.18em; text-transform:uppercase; color:rgba(246,246,246,.5); width:120px; flex-shrink:0\">Data</span>\n              <span style=\"font-size:17px; color:#F6F6F6\">14 de setembro de 2026, \u00e0s 19h</span>\n            </div>\n            <div style=\"display:flex; gap:14px; align-items:baseline; border-top:1px solid rgba(246,246,246,.16); padding-top:12px\">\n              <span style=\"font-family:'Nimbus Sans Cond',Helvetica,Arial,sans-serif; font-size:13px; letter-spacing:.18em; text-transform:uppercase; color:rgba(246,246,246,.5); width:120px; flex-shrink:0\">Formato</span>\n              <span style=\"font-size:17px; color:#F6F6F6\">100% ao vivo, pelo Zoom</span>\n            </div>\n            <div style=\"display:flex; gap:14px; align-items:baseline; border-top:1px solid rgba(246,246,246,.16); border-bottom:1px solid rgba(246,246,246,.16); padding:12px 0\">\n              <span style=\"font-family:'Nimbus Sans Cond',Helvetica,Arial,sans-serif; font-size:13px; letter-spacing:.18em; text-transform:uppercase; color:rgba(246,246,246,.5); width:120px; flex-shrink:0\">Investimento</span>\n              <span style=\"font-size:17px; color:#F6F6F6\">R$ 27 (menos que um mc donalds)</span>\n            </div>\n          </div>\n          <button class=\"jp-button\" onclick=\"window.open('https://pay.hub.la/yeb66V7cjFiyxzbC1PE7','_blank','noopener')\">Garantir minha vaga por R$ 27</button>\n        </div>\n        <div></div>\n      </div>\n    </div>\n  </section>\n\n  <section data-screen-label=\"Identifica\u00e7\u00e3o\" style=\"padding:clamp(56px,8vw,88px) clamp(20px,5vw,72px)\">\n    <div style=\"max-width:1200px; margin:0 auto\">\n      <div style=\"text-align:center\">\n        <span class=\"jp-pill\">Se identifica?</span>\n        <h2 style=\"font-family:'Bethany Elingston',Georgia,serif; font-weight:400; font-size:clamp(34px,4.4vw,52px); line-height:1.1; margin:20px 0 16px\">J\u00e1 s\u00e3o mais de 8 meses de 2026</h2>\n        <p style=\"font-size:17px; line-height:1.9; max-width:640px; margin:0 auto\"><span style=\"background:#D3FB04; color:#191919; font-weight:700; padding:3px 8px; box-decoration-break:clone; -webkit-box-decoration-break:clone\">E o seu consult\u00f3rio continua exatamente como estava em janeiro, ou voc\u00ea est\u00e1 come\u00e7ando agora, perdida.</span></p>\n      </div>\n      <div style=\"display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:16px; margin-top:44px\">\n        <div class=\"jp-card\">\n          <div style=\"font-family:'Bethany Elingston',Georgia,serif; font-size:23px; line-height:1.25; margin-bottom:10px\">Voc\u00ea posta, se dedica, tenta</div>\n          <div style=\"font-size:16px; line-height:1.6; color:rgba(25,25,25,.72)\">E n\u00e3o v\u00ea o resultado que esperava chegar.</div>\n        </div>\n        <div class=\"jp-card\">\n          <div style=\"font-family:'Bethany Elingston',Georgia,serif; font-size:23px; line-height:1.25; margin-bottom:10px\">Depende de indica\u00e7\u00e3o</div>\n          <div style=\"font-size:16px; line-height:1.6; color:rgba(25,25,25,.72)\">Cobra menos do que devia e v\u00ea o ano passando.</div>\n        </div>\n        <div class=\"jp-card\">\n          <div style=\"font-family:'Bethany Elingston',Georgia,serif; font-size:23px; line-height:1.25; margin-bottom:10px\">A mesma pergunta voltando</div>\n          <div style=\"font-size:16px; line-height:1.6; color:rgba(25,25,25,.72)\">\u201cSer\u00e1 que 2027 tamb\u00e9m vai terminar assim?\u201d</div>\n        </div>\n      </div>\n      <p style=\"max-width:640px; margin:40px auto 0; text-align:center; font-size:19px; line-height:1.6; color:#191919; text-wrap:pretty\">\n        Voc\u00ea estudou anos pra isso. Se dedicou. Faz um trabalho excelente. Mas o ano est\u00e1 acabando e o consult\u00f3rio continua igual.\n      </p>\n    </div>\n  </section>\n\n  <section data-screen-label=\"Valida\u00e7\u00e3o\" style=\"padding:0 clamp(20px,5vw,72px) clamp(56px,8vw,88px)\">\n    <div style=\"max-width:900px; margin:0 auto\">\n      <div class=\"jp-card jp-card--pad48\">\n        <div style=\"text-align:center\">\n          <h2 style=\"font-family:'Bethany Elingston',Georgia,serif; font-weight:400; font-size:clamp(30px,3.8vw,44px); line-height:1.1; margin:0 0 18px\">Sabe como eu sei disso?</h2>\n          <p style=\"font-size:17px; line-height:1.9; color:rgba(25,25,25,.72); max-width:640px; margin:0 auto 14px\">\n            Eu sei porque eu j\u00e1 passei por isso. <span style=\"background:#D3FB04; color:#191919; font-weight:700; padding:3px 8px; box-decoration-break:clone; -webkit-box-decoration-break:clone\">Cobrava R$ 80 por sess\u00e3o, postava sem estrat\u00e9gia e achava que o problema era o algoritmo.</span> At\u00e9 entender que faltava m\u00e9todo, n\u00e3o vontade.\n          </p>\n          <p style=\"font-size:17px; line-height:1.6; color:#191919; max-width:640px; margin:0 auto\">\n            Voc\u00ea \u00e9 excelente no que faz. S\u00f3 ainda n\u00e3o aprendeu a fazer isso virar agenda cheia, ainda.\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section data-screen-label=\"Oportunidade\" style=\"background:#191919; color:#F6F6F6; padding:clamp(56px,8vw,88px) clamp(20px,5vw,72px)\">\n    <div style=\"max-width:1200px; margin:0 auto\">\n      <div class=\"jp-section-header jp-section-header--dark\"><span class=\"jp-pill jp-pill--dark\">Os dados que provam</span><h2>A demanda nunca foi t\u00e3o grande</h2><p>O Brasil fechou 2025 com mais de 546 mil afastamentos por sa\u00fade mental, recorde batido pela segunda vez em 10 anos. \u00c9 a nossa oportunidade aqui no digital de captar essas pessoas.</p></div>\n      <div style=\"display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-top:48px\">\n        <div style=\"background:#262626; border-radius:14px; padding:28px 22px\">\n          <div style=\"font-family:'Bethany Elingston',Georgia,serif; font-size:clamp(38px,4vw,52px); line-height:1; color:#D3FB04\">546 mil+</div>\n          <div style=\"font-size: